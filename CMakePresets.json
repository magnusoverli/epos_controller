{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Debug build with tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON" }
    },
    {
      "name": "release",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "sanitize",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/sanitize",
      "cacheVariables": { "HEADSET_SANITIZERS": "ON" }
    },
    {
      "name": "parser",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/parser",
      "cacheVariables": { "HEADSET_PARSER_ONLY": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "sanitize", "configurePreset": "sanitize" },
    { "name": "parser", "configurePreset": "parser" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "sanitize", "configurePreset": "sanitize", "output": { "outputOnFailure": true } },
    { "name": "parser", "configurePreset": "parser", "output": { "outputOnFailure": true } }
  ]
}
